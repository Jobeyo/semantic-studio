generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id            Int             @id @default(autoincrement())
  name          String
  createdAt     DateTime        @default(now())
  users         User[]
  models        SemanticModel[]
  llmProviders  LLMProvider[]
  glossaryTerms GlossaryTerm[]
  changeLogs    ChangeLog[]
}

model AgentConfig {
  id               Int      @id @default(autoincrement())
  orgId            Int      @unique
  agentName        String   @default("Studio AI")
  agentDescription String?
  agentPersona     String?
  systemPromptExtra String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model User {
  id           Int          @id @default(autoincrement())
  name         String
  email        String       @unique
  passwordHash String
  role         String       @default("editor") // admin, editor, viewer
  orgId        Int
  org          Organization @relation(fields: [orgId], references: [id])
  createdAt    DateTime     @default(now())
  changelogs   Changelog[]
  changeLogs   ChangeLog[]
}

model SemanticModel {
  id            Int            @id @default(autoincrement())
  name          String
  description   String?
  orgId         Int
  org           Organization   @relation(fields: [orgId], references: [id])
  sourceType    String // postgres, sqlserver, mysql, sqlite
  sourceConfig  Json // krypterad anslutningsinformation
  status        String         @default("draft") // draft, published, archived
  owner         String?        // Ansvarig person
  ownerEmail    String?        // E-post till ansvarig
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  views         ModelView[]
  versions      ModelVersion[]
  changelogs    Changelog[]
  glossaryTerms GlossaryTerm[]
  changeLogs    ChangeLog[]
  ontologyConcepts  OntologyConcept[]
  ontologyRelations OntologyRelation[]
  ontologyRules     OntologyRule[]
}

model ModelView {
  id          Int           @id @default(autoincrement())
  modelId     Int
  model       SemanticModel @relation(fields: [modelId], references: [id])
  name        String // Vyns namn i databasen
  displayName String // Affärsnamn
  description String?
  type        String // fact, dimension, measure, kpi
  sql         String // Den SQL-fråga som skapar vyn
  columns     ViewColumn[]
  qualityRules DataQualityRule[]
  ontologyConcepts OntologyConcept[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ViewColumn {
  id          Int       @id @default(autoincrement())
  viewId      Int
  view        ModelView @relation(fields: [viewId], references: [id])
  name        String // Kolumnnamn i DB
  displayName String // Affärsnamn
  description String?
  dataType    String // string, number, date, boolean
  isKey       Boolean   @default(false)
  isMeasure   Boolean   @default(false)
  format      String? // ex. "#,##0.00", "YYYY-MM-DD"
  isDerived   Boolean   @default(false) // Härlett mått eller härledd kolumn
  expression  String?   // SQL-uttryck för härledda kolumner/mått
  createdAt   DateTime  @default(now())
  ontologyProperties OntologyProperty[]
}

model ModelVersion {
  id        Int           @id @default(autoincrement())
  modelId   Int
  model     SemanticModel @relation(fields: [modelId], references: [id])
  version   Int
  snapshot  Json // Hela modellens snapshot vid denna version
  createdAt DateTime      @default(now())
  createdBy Int?
}

model Changelog {
  id        Int           @id @default(autoincrement())
  modelId   Int
  model     SemanticModel @relation(fields: [modelId], references: [id])
  userId    Int?
  user      User?         @relation(fields: [userId], references: [id])
  action    String // created, updated, published, deleted
  details   String?
  createdAt DateTime      @default(now())
}

model LLMProvider {
  id        Int          @id @default(autoincrement())
  name      String
  type      String // claude, openai, ollama
  apiKey    String       @default("")
  config    Json         @default("{}")
  isDefault Boolean      @default(false)
  orgId     Int
  org       Organization @relation(fields: [orgId], references: [id])
  createdAt DateTime     @default(now())
}

model ChangeLog {
  id         Int            @id @default(autoincrement())
  orgId      Int
  org        Organization   @relation(fields: [orgId], references: [id])
  modelId    Int?
  model      SemanticModel? @relation(fields: [modelId], references: [id])
  userId     Int?
  user       User?          @relation(fields: [userId], references: [id])
  action     String // published, unpublished, generated, view_created, view_updated, glossary_added, model_created, model_deleted
  entityType String // model, view, glossary, user
  entityName String?
  details    String?
  actor      String // email or 'AI'
  createdAt  DateTime       @default(now())
}

model GlossaryTerm {
  id         Int            @id @default(autoincrement())
  orgId      Int
  org        Organization   @relation(fields: [orgId], references: [id])
  modelId    Int?
  model      SemanticModel? @relation(fields: [modelId], references: [id])
  name       String
  definition String
  synonym    String?
  dataSource String?
  type       String // dimension, measure, concept
  createdBy  String // AI or email
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  updatedBy  String?
  ontologyConcepts OntologyConcept[]
}

model DataQualityRule {
  id          Int       @id @default(autoincrement())
  viewId      Int
  view        ModelView @relation(fields: [viewId], references: [id], onDelete: Cascade)
  columnName  String
  ruleType    String    // not_null, unique, min, max, regex, custom_sql
  ruleValue   String?   // värde för regeln tex regex-pattern eller min-värde
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─── Ontologi ────────────────────────────────────────────────────────────────
// Ontologin hör till en affärsmodell och publiceras tillsammans med den.

model OntologyConcept {
  id             Int                @id @default(autoincrement())
  modelId        Int
  model          SemanticModel      @relation(fields: [modelId], references: [id], onDelete: Cascade)
  name           String             // Begreppets namn, t.ex. "Kund"
  description    String?
  synonyms       String[]           @default([]) // t.ex. ["klient", "beställare"]
  glossaryTermId Int?               // Länk till term i Business Glossary
  glossaryTerm   GlossaryTerm?      @relation(fields: [glossaryTermId], references: [id], onDelete: SetNull)
  viewId         Int?               // Vyn som representerar begreppet
  view           ModelView?         @relation(fields: [viewId], references: [id], onDelete: SetNull)
  keyColumn      String?            // Identifierande kolumn i vyn
  owner          String?
  createdBy      String             // AI eller e-post
  updatedBy      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  properties     OntologyProperty[]
  outgoing       OntologyRelation[] @relation("RelationFrom")
  incoming       OntologyRelation[] @relation("RelationTo")
  rules          OntologyRule[]

  @@unique([modelId, name])
}

model OntologyProperty {
  id          Int             @id @default(autoincrement())
  conceptId   Int
  concept     OntologyConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  columnId    Int?            // Kolumnen i modellen som egenskapen motsvarar
  column      ViewColumn?     @relation(fields: [columnId], references: [id], onDelete: SetNull)
  name        String          // Affärsnamn, t.ex. "Vikt"
  description String?
  unit        String?         // kg, ton, SEK, st, % ...
  isMeasure   Boolean         @default(false)
  createdAt   DateTime        @default(now())
}

model OntologyRelation {
  id            Int             @id @default(autoincrement())
  modelId       Int
  model         SemanticModel   @relation(fields: [modelId], references: [id], onDelete: Cascade)
  fromConceptId Int
  fromConcept   OntologyConcept @relation("RelationFrom", fields: [fromConceptId], references: [id], onDelete: Cascade)
  toConceptId   Int
  toConcept     OntologyConcept @relation("RelationTo", fields: [toConceptId], references: [id], onDelete: Cascade)
  verb          String          // t.ex. "lägger" (Kund lägger Order)
  inverseVerb   String?         // t.ex. "läggs av"
  cardinality   String          @default("one_to_many") // one_to_one, one_to_many, many_to_one, many_to_many
  joinCondition String?         // t.ex. "fact_order.customer_id = dim_customer.id"
  description   String?
  createdBy     String
  updatedBy     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model OntologyRule {
  id          Int              @id @default(autoincrement())
  modelId     Int
  model       SemanticModel    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  conceptId   Int?
  concept     OntologyConcept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  name        String           // t.ex. "Återvinningsbart material"
  description String           // Regeln i klartext
  expression  String?          // SQL-uttryck, t.ex. "material_group IN ('Metall','Papper')"
  ruleType    String           @default("definition") // definition, filter, calculation, unit, constraint
  createdBy   String
  updatedBy   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}
